# GateGuard V2 — copy to .env and fill in. Never commit .env.
# Generate JWT_SECRET and TICKET_SIGNING_KEY with: npm run keys

# MongoDB connection string (local default shown; use MongoDB Atlas in production)
MONGODB_URI=mongodb://127.0.0.1:27017/gateguard_v2_dev

# Session signing secret (random, >= 32 bytes)
JWT_SECRET=replace-me

# Ed25519 private key (PKCS8 DER, base64) used to sign ticket QR codes.
# Server-only. The matching public key is served at /api/public/ticket-key.
TICKET_SIGNING_KEY=replace-me

# Comma-separated origins allowed to call the API cross-origin (dev frontend).
CORS_ORIGINS=http://localhost:5174

# API port for local development
PORT=3002

# Seed script (npm run seed): first admin account and demo workspace
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=change-me-to-something-long
SEED_DEMO=true
DEMO_PASSWORD=gateguard-demo
